{
  "@context": {
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "ont": "http://www.zhengjinfa.org/sensors/ontology#",
    "res": "http://www.zhengjinfa.org/sensors/resource/",
    "includes": { "@id": "ont:includes", "@type": "@id" },
    "hasMeasurement": { "@id": "ont:hasMeasurement", "@type": "@id" },
    "hasTemperature": { "@id": "ont:hasTemperature", "@type": "xsd:integer" },
    "atTime": { "@id": "ont:atTime", "@type": "xsd:dateTime" },
    "hasOwner": { "@id": "ont:hasOwner", "@type": "@id" },
    "hasName": { "@id": "ont:hasName", "@type": "xsd:string" }
  },
  "@graph": [
    {
      "@id": "res:Class01",
      "includes": ["res:Sensor029", "res:Computer101"]
    },
    {
      "@id": "res:Sensor029",
      "hasMeasurement": "res:Measurement8401"
    },
    {
      "@id": "res:Measurement8401",
      "hasTemperature": "29",
      "atTime": "2010-06-12T12:00:12"
    },
    {
      "@id": "res:Computer101",
      "hasOwner": "res:User10A"
    },
    {
      "@id": "res:User10A",
      "hasName": "Pedro"
    }
  ]
}
