@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rml:    <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:     <http://semweb.mmlab.be/ns/ql#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix bpm:    <https://w3id.org/breatheplay-madrid/ontology#> .
@base           <https://w3id.org/breatheplay-madrid/mappings/instalaciones-deportivas#> .

# Group04 - Breathe & Play Madrid. Run from the HandsOn/Group04 directory
# (python mappings/generate_rdf.py), so that the csv/ paths resolve.
# Dataset: Instalaciones deportivas municipales básicas (Ayuntamiento de Madrid, 200215)
# Source:  csv/200215-0-instalaciones-deportivas-csv-csv-updated.csv

# ---------------------------------------------------------------------------
# Sports facilities
# ---------------------------------------------------------------------------
<#SportsFacilityMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/200215-0-instalaciones-deportivas-csv-csv-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/sports-facility/{PK}" ;
        rr:termType rr:IRI ;
        rr:class bpm:SportsFacility
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:facilityId ;
        rr:objectMap [ rml:reference "PK" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "NOMBRE" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:equipment ;
        rr:objectMap [ rml:reference "EQUIPAMIENTO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:transportInfo ;
        rr:objectMap [ rml:reference "TRANSPORTE" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:contentURL ;
        rr:objectMap [ rml:reference "CONTENT-URL" ; rr:termType rr:Literal ; rr:datatype xsd:anyURI ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:address ;
        rr:objectMap [ rml:reference "DIRECCION" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:postalCode ;
        rr:objectMap [ rml:reference "CODIGO-POSTAL" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:latitude ;
        rr:objectMap [ rml:reference "LATITUD" ; rr:termType rr:Literal ; rr:datatype xsd:decimal ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:longitude ;
        rr:objectMap [ rml:reference "LONGITUD" ; rr:termType rr:Literal ; rr:datatype xsd:decimal ]
    ] ;

    # Distance in kilometres
    rr:predicateObjectMap [
        rr:predicate bpm:distanceToNearestStation ;
        rr:objectMap [ rml:reference "DISTANCIA_ESTACION_KM" ; rr:termType rr:Literal ; rr:datatype xsd:decimal ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:hasFacilityType ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/facility-type/{TIPO_ID}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:hasAccessibilityLevel ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/accessibility-level/{ACCESIBILIDAD}" ;
            rr:termType rr:IRI
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:locatedInDistrict ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/district/{COD-DISTRITO}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Not generated for the 8 rows with an empty BARRIO_ID
    rr:predicateObjectMap [
        rr:predicate bpm:locatedInNeighbourhood ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/neighbourhood/{BARRIO_ID}" ;
            rr:termType rr:IRI
        ]
    ] ;

    # Link to the air quality stations dataset:
    # join ESTACION_CERCANA (this CSV) = CODIGO (stations CSV)
    rr:predicateObjectMap [
        rr:predicate bpm:hasNearestStation ;
        rr:objectMap [
            rr:parentTriplesMap <#MonitoringStationMap> ;
            rr:joinCondition [
                rr:child "ESTACION_CERCANA" ;
                rr:parent "CODIGO"
            ]
        ]
    ] .

# ---------------------------------------------------------------------------
# Monitoring stations (parent of the join above). Same IRI pattern as in
# estaciones-control-aire.rml, so the resources merge across datasets.
# ---------------------------------------------------------------------------
<#MonitoringStationMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/212629-0-estaciones-control-aire-csv-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/station/{CODIGO}" ;
        rr:termType rr:IRI ;
        rr:class bpm:MonitoringStation
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "ESTACION" ; rr:termType rr:Literal ; rr:language "es" ]
    ] .

# ---------------------------------------------------------------------------
# Facility types
# ---------------------------------------------------------------------------
<#FacilityTypeMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/200215-0-instalaciones-deportivas-csv-csv-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/facility-type/{TIPO_ID}" ;
        rr:termType rr:IRI ;
        rr:class bpm:FacilityType
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "TIPO_NOMBRE" ; rr:termType rr:Literal ; rr:language "es" ]
    ] .

# ---------------------------------------------------------------------------
# Accessibility levels (0 No accesible, 1 Accesible, 2 Parcialmente accesible, 3 Sin información)
# ---------------------------------------------------------------------------
<#AccessibilityLevelMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/200215-0-instalaciones-deportivas-csv-csv-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/accessibility-level/{ACCESIBILIDAD}" ;
        rr:termType rr:IRI ;
        rr:class bpm:AccessibilityLevel
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "ACCESIBILIDAD_NOMBRE" ; rr:termType rr:Literal ; rr:language "es" ]
    ] .

# ---------------------------------------------------------------------------
# Districts
# ---------------------------------------------------------------------------
<#DistrictMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/200215-0-instalaciones-deportivas-csv-csv-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/district/{COD-DISTRITO}" ;
        rr:termType rr:IRI ;
        rr:class bpm:District
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:districtCode ;
        rr:objectMap [ rml:reference "COD-DISTRITO" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "DISTRITO" ; rr:termType rr:Literal ; rr:language "es" ]
    ] .

# ---------------------------------------------------------------------------
# Neighbourhoods
# ---------------------------------------------------------------------------
<#NeighbourhoodMap> a rr:TriplesMap ;
    rml:logicalSource [
        rml:source "csv/200215-0-instalaciones-deportivas-csv-csv-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/breatheplay-madrid/resource/neighbourhood/{BARRIO_ID}" ;
        rr:termType rr:IRI ;
        rr:class bpm:Neighbourhood
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:neighbourhoodCode ;
        rr:objectMap [ rml:reference "BARRIO_ID" ; rr:termType rr:Literal ; rr:datatype xsd:string ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:label ;
        rr:objectMap [ rml:reference "BARRIO" ; rr:termType rr:Literal ; rr:language "es" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate bpm:isPartOfDistrict ;
        rr:objectMap [
            rr:template "https://w3id.org/breatheplay-madrid/resource/district/{COD-DISTRITO}" ;
            rr:termType rr:IRI
        ]
    ] .
