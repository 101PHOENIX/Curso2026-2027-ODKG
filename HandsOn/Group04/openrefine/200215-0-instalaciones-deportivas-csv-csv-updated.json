    "baseColumnName": "LONGITUD",
    "expression": "jython:import math\nstations = [('28079004', 40.4238823, -3.7122567), ('28079008', 40.4215533, -3.6823158), ('28079011', 40.4514734, -3.6773491), ('28079016', 40.4400457, -3.6392422), ('28079017', 40.347147, -3.7133167), ('28079018', 40.3947825, -3.7318356), ('28079024', 40.4193577, -3.7473445), ('28079027', 40.4769179, -3.5800258), ('28079035', 40.4192091, -3.7031662), ('28079036', 40.4079517, -3.6453104), ('28079038', 40.4455439, -3.7071303), ('28079039', 40.4782322, -3.7115364), ('28079040', 40.3881478, -3.6515286), ('28079047', 40.3980991, -3.6868138), ('28079048', 40.4398904, -3.6903729), ('28079049', 40.4144444, -3.6824999), ('28079050', 40.4655841, -3.6887449), ('28079054', 40.3730118, -3.6121394), ('28079055', 40.4623628, -3.5805649), ('28079056', 40.3850336, -3.7187679), ('28079057', 40.4942012, -3.6605173), ('28079058', 40.5180701, -3.7746101), ('28079059', 40.465144, -3.609031), ('28079060', 40.5005477, -3.6897308)]\nlat = math.radians(float(cells['LATITUD']['value']))\nlon = math.radians(float(value))\nbest = None\nfor code, slat, slon in stations:\n    p, q = math.radians(slat), math.radians(slon)\n    a = math.sin((p - lat) / 2) ** 2 + math.cos(lat) * math.cos(p) * math.sin((q - lon) / 2) ** 2\n    d = 2 * 6371.0 * math.asin(math.sqrt(a))\n    if best is None or d < best[0]:\n        best = (d, code)\nreturn best[1]",
    "onError": "set-to-blank",
