# A generic name that the source repeats (analysis 1.4 #11). Its host, the Centre Esportiu Municipal
# de Sant Sebastià, has no Wikidata item, so there is no hr:isHostedBy link. Opening hours omitted:
# the source table mixes hours, prices and notes.
shelter:98110133629 rdf:type hr:ClimateShelter ;
    rdfs:label "Piscina Descoberta"@ca ;
    hr:hasShelterCategory shelterCat:SwimmingPool ;
    hr:streetAddress "Plaça del Mar, 1" ;
    hr:etrs89X 432253.3517315788 ;
    hr:etrs89Y 4580755.282194903 ;
    geo:lat 41.3754657408768 ;
    geo:long 2.1898545572534602 ;
    hr:telephone "932210506" ;
    hr:isLocatedInNeighbourhood neighbourhood:03 .

