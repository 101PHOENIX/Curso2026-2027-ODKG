    rdfs:label "Library"@en .

shelterCat:Other rdf:type hr:ShelterCategory ;
    rdfs:label "Other"@en .

shelterCat:SwimmingPool rdf:type hr:ShelterCategory ;
    rdfs:label "Swimming pool"@en .

