species:108 rdf:type hr:TreeSpecies ;
    rdfs:label "Pinus pinea" ;
    hr:scientificName "Pinus pinea" ;
    hr:spanishName "Pino piñonero" ;
    hr:catalanName "Pi pinyoner" , "pi pinyer" ;
    owl:sameAs wd:Q106094 .

# Same taxon as Platanus × hispanica, the name used in Wikidata.
species:126 rdf:type hr:TreeSpecies ;
    rdfs:label "Platanus × acerifolia" ;
    hr:scientificName "Platanus × acerifolia" ;
    hr:spanishName "Plátano" ;
    hr:catalanName "Plàtan" ;
    owl:sameAs wd:Q161374 .

# A cultivar: linked to the item of its species with skos:broadMatch, not owl:sameAs.
species:5286580 rdf:type hr:TreeSpecies ;
    rdfs:label "Platanus × acerifolia 'Alphen's Globe'" ;
    hr:scientificName "Platanus × acerifolia 'Alphen's Globe'" ;
    skos:broadMatch wd:Q161374 .

