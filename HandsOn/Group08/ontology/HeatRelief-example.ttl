@prefix hr:            <https://w3id.org/barcelona-heat-relief/ontology/HeatRelief#> .
@prefix shelter:       <https://w3id.org/barcelona-heat-relief/resource/ClimateShelter/> .
@prefix shelterCat:    <https://w3id.org/barcelona-heat-relief/resource/ShelterCategory/> .
@prefix fountain:      <https://w3id.org/barcelona-heat-relief/resource/DrinkingFountain/> .
@prefix tree:          <https://w3id.org/barcelona-heat-relief/resource/StreetTree/> .
@prefix species:       <https://w3id.org/barcelona-heat-relief/resource/TreeSpecies/> .
@prefix neighbourhood: <https://w3id.org/barcelona-heat-relief/resource/Neighbourhood/> .
@prefix district:      <https://w3id.org/barcelona-heat-relief/resource/District/> .
@prefix rdf:           <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:          <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:           <http://www.w3.org/2002/07/owl#> .
@prefix skos:          <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:           <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:           <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix wd:            <http://www.wikidata.org/entity/> .

# Sample instantiation of the Barcelona Heat Relief ontology with real records
# of the three source files (Open Data BCN, CC BY 4.0). Values are copied from
# the CSV files; blank values and placeholders ("SENSE INFORMAR") produce no triple.

# The file imports the ontology, so that tools such as Protégé read the property values with
# their declared types. Until the w3id IRI is registered, catalog-v001.xml maps it to HeatRelief.ttl.
[] rdf:type owl:Ontology ;
    owl:imports <https://w3id.org/barcelona-heat-relief/ontology/HeatRelief> .

#################################################################
#    Climate shelters (xarxa-refugis-climatics.csv)
#################################################################

shelter:99400780928 rdf:type hr:ClimateShelter ;
    rdfs:label "Refugi climàtic"@ca ;
    hr:hasShelterCategory shelterCat:Other ;
    hr:streetAddress "Plaça de Valentí Almirall, 1" ;
    hr:etrs89X 432466.9569089691 ;
    hr:etrs89Y 4584469.3650011495 ;
    geo:lat 41.40893542278706 ;
    geo:long 2.191994563654206 ;
    hr:openingHours "De dilluns a divendres: de 08.30 h a 14.30 h" ;
    hr:website "http://ajuntament.barcelona.cat/santmarti"^^xsd:anyURI ;
    hr:isLocatedInNeighbourhood neighbourhood:65 .

# Opening hours omitted in this sample: the source holds a table with several periods.
