[
  {
    "op": "core/column-reorder",
    "columnNames": [
      "ID",
      "BARRIO",
      "DISTRITO",
      "ESTADO",
      "LATITUD",
      "LONGITUD",
      "TIPO_VIA",
      "NOM_VIA",
      "NUM_VIA"
    ],
    "description": "Reorganizar columnas"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "DISTRITO",
    "expression": "value.trim()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Transforma el texto de las celdas en la columna DISTRITO usando la expresión value.trim()"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "BARRIO",
    "expression": "value.trim()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Transforma el texto de las celdas en la columna BARRIO usando la expresión value.trim()"
  },
  {
    "op": "core/mass-edit",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "ESTADO",
    "expression": "value",
    "edits": [
      {
        "from": [
          "CERRADA_TEMPORALMENT"
        ],
        "fromBlank": false,
        "fromError": false,
        "to": "CERRADA_TEMPORALMENTE"
      }
    ],
    "description": "Editar celdas en masa en columna ESTADO"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "NOM_VIA",
    "expression": "value.trim()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Transforma el texto de las celdas en la columna NOM_VIA usando la expresión value.trim()"
  },
  {
    "op": "core/row-removal",
    "engineConfig": {
      "facets": [
        {
          "type": "list",
          "name": "LATITUD",
          "expression": "isBlank(value)",
          "columnName": "LATITUD",
          "invert": false,
          "omitBlank": false,
          "omitError": false,
          "selection": [
            {
              "v": {
                "v": true,
                "l": "true"
              }
            }
          ],
          "selectBlank": false,
          "selectError": false
        }
      ],
      "mode": "row-based"
    },
    "description": "Remove rows"
  }
]