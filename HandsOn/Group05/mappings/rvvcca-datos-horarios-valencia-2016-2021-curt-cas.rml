@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .
@prefix aq:  <https://w3id.org/valencia-airquality/ontology/airquality#> .
@prefix station: <https://w3id.org/valencia-airquality/resource/MonitoringStation/> .
@prefix prop: <https://w3id.org/valencia-airquality/resource/ObservableProperty/> .
@prefix obs: <https://w3id.org/valencia-airquality/resource/Observation/> .
@prefix data: <https://w3id.org/valencia-airquality/dataset/property/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix city: <https://w3id.org/valencia-airquality/resource/City/> .

_:csvSource
  rml:source "csv/rvvcca-datos-horarios-valencia-2016-2021-curt-cas-updated.csv" ;
  rml:referenceFormulation ql:CSV .

<#RecordContextMap>
  a rr:TriplesMap ;
  rml:logicalSource _:csvSource ;
  rr:subjectMap [
    rr:template "https://w3id.org/valencia-airquality/dataset/record/{id}" ;
    rr:class data:Record
  ] ;
  rr:predicateObjectMap [
    rr:predicate data:date ;
    rr:objectMap [ rml:reference "Fecha" ; rr:datatype xsd:date ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate data:dayOfWeek ;
    rr:objectMap [ rml:reference "Día de la semana" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate data:dayOfMonth ;
    rr:objectMap [ rml:reference "Día del mes" ; rr:datatype xsd:integer ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate data:hour ;
    rr:objectMap [ rml:reference "Hora" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate data:station ;
    rr:objectMap [ rr:template "https://w3id.org/valencia-airquality/resource/MonitoringStation/{Estación}" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate data:hasNoMeasurements ;
    rr:objectMap [ rml:reference "sin_mediciones" ; rr:datatype xsd:boolean ]
  ] .

<#StationMap>
  a rr:TriplesMap ;
  rml:logicalSource _:csvSource ;
  rr:subjectMap [
    rr:template "https://w3id.org/valencia-airquality/resource/MonitoringStation/{Estación}" ;
    rr:class aq:MonitoringStation
  ] ;
  rr:predicateObjectMap [
    rr:predicate aq:stationName ;
    rr:objectMap [ rml:reference "Estación" ; rr:datatype xsd:string ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "Estación" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate aq:locatedInCity ;
    rr:objectMap [ rr:constant city:Valencia ]
  ] .

<#CityMap>
  a rr:TriplesMap ;
  rml:logicalSource _:csvSource ;
  rr:subjectMap [
    rr:constant city:Valencia ;
    rr:class aq:City
  ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rr:constant "Valencia" ]
  ] .

<#PM1Map>
  a rr:TriplesMap ;
  rml:logicalSource _:csvSource ;
  rr:subjectMap [ rr:template "https://w3id.org/valencia-airquality/resource/Observation/{id}_PM1" ; rr:class aq:Observation ] ;
  rr:predicateObjectMap [ rr:predicate aq:hasStation ; rr:objectMap [ rr:template "https://w3id.org/valencia-airquality/resource/MonitoringStation/{Estación}" ] ] ;
  rr:predicateObjectMap [ rr:predicate aq:observedProperty ; rr:objectMap [ rr:constant prop:PM1 ] ] ;
  rr:predicateObjectMap [ rr:predicate aq:resultValue ; rr:objectMap [ rml:reference "PM1" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate data:fromRecord ; rr:objectMap [ rr:template "https://w3id.org/valencia-airquality/dataset/record/{id}" ] ] .

