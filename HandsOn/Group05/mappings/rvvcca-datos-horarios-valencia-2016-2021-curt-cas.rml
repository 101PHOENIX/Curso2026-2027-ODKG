  rr:predicateObjectMap [ rr:predicate aq:observedProperty ; rr:objectMap [ rr:constant prop:PM25 ] ] ;
  rr:predicateObjectMap [ rr:predicate aq:resultValue ; rr:objectMap [ rml:reference "PM2.5" ; rr:datatype xsd:decimal ] ] ;
  rr:predicateObjectMap [ rr:predicate data:fromRecord ; rr:objectMap [ rr:template "https://w3id.org/valencia-airquality/dataset/record/{id}" ] ] .

