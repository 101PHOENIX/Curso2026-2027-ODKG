# Directly grounded in the supplied historical CSV row for Almagro, January 2019 (Monthly occupancies).

occ:5000-2019-01 a pm:MonthlyOccupancy ;
    pm:isOccupancyOf par:5000 ;
    pm:hasReferencePeriod "2019-01" ;
    pm:hasNumberOfSpaces 437 ;
    pm:hasCalculationDays 31 ;
    pm:hasAverageDailyVehicles "73"^^xsd:decimal ;
    pm:hasOccupancyRate "16.70"^^xsd:decimal ;
    pm:hasDaytimeOccupancyRate "26.30"^^xsd:decimal .

