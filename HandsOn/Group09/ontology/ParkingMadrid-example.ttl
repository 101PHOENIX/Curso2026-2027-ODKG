    pm:hasServiceCode "12" ;
    geo:lat "40.4077362146594"^^xsd:decimal ;
    geo:long "-3.70421674570288"^^xsd:decimal ;
    pm:hasCadastralReference "0335701VK4703E0002UQ" ;
    pm:hasOfficialURL <http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=856bc2c6e051c010VgnVCM2000000c205a0aRCRD> ;
    pm:hasPKCode "81690" ;
    pm:hasStreetAddress "CALLE DEL MESÓN DE PAREDES NUM 66 PLTA -2, 28012 MADRID" ;
    pm:locatedInDistrict dis:1 ;
