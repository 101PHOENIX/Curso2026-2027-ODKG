@prefix dis: <https://parking-madrid.example.org/resource/district/> .
@prefix occ: <https://parking-madrid.example.org/resource/occupancy/> .
@prefix par: <https://parking-madrid.example.org/resource/parking/> .
@prefix bar: <https://parking-madrid.example.org/resource/neighbourhood/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pm:  <https://parking-madrid.example.org/ontology#> .

# Example RDF data illustrating the Parking Madrid ontology.
# The January 2019 occupancy record: 
#   - Almagro, OLAVIDE, SEVILLA, MOSTENSES, ENCUENTRO
# and the three inventory records: 
#   - Aguilar de Campoo, Aguilón, and Agustín Lara
# Other records are illustrative examples and should not be
# interpreted as verified records from the source datasets.

# -------------------------------------------------------- Districts

dis:7 a pm:District ;
    pm:hasDistrictCode 7 ;
    pm:hasDistrictName "CHAMBERI" .

dis:1 a pm:District ;
    pm:hasDistrictCode 1 ;
    pm:hasDistrictName "CENTRO" .

dis:14 a pm:District ;
    pm:hasDistrictCode 14 ;
    pm:hasDistrictName "MORATALAZ" .

dis:9 a pm:District ;
    pm:hasDistrictCode 9 ;
    pm:hasDistrictName "MONCLOA-ARAVACA" .

dis:2 a pm:District ;
    pm:hasDistrictCode 2 ;
    pm:hasDistrictName "ARGANZUELA" .

# -------------------------------------------------------- Neighbourhoods

bar:9-4 a pm:Neighbourhood ;
    pm:hasNeighbourhoodCode 4 ;
    pm:hasNeighbourhoodName "VALDEZARZA" ;
    pm:belongsToDistrict dis:9 .

bar:2-3 a pm:Neighbourhood ;
    pm:hasNeighbourhoodCode 3 ;
    pm:hasNeighbourhoodName "CHOPERA" ;
    pm:belongsToDistrict dis:2 .

bar:1-2 a pm:Neighbourhood ;
    pm:hasNeighbourhoodCode 2 ;
    pm:hasNeighbourhoodName "EMBAJADORES" ;
    pm:belongsToDistrict dis:1 .

# -------------------------------------------------------- Car parks

# Examples from the historical (occupa) data.

par:5000 a pm:RotationalParkingFacility ;
    pm:hasParCode 5000 ;
    pm:hasParkingName "ALMAGRO" ;
    pm:hasParkingType "ROT" ;
    pm:hasTotalSpaces 453 ;
    pm:locatedInDistrict dis:7 .

par:5012 a pm:RotationalParkingFacility ;
    pm:hasParCode 5012 ;
    pm:hasParkingName "OLAVIDE" ;
    pm:hasParkingType "ROT" ;
    pm:hasTotalSpaces 383 ;
    pm:locatedInDistrict dis:7 .

par:114 a pm:RotationalParkingFacility ;
    pm:hasParCode 114 ;
    pm:hasParkingName "SEVILLA" ;
    pm:hasParkingType "ROT" ;
    pm:hasTotalSpaces 393 ;
    pm:locatedInDistrict dis:1 .

par:5010 a pm:RotationalParkingFacility ;
    pm:hasParCode 5010 ;
    pm:hasParkingName "MOSTENSES" ;
    pm:hasParkingType "ROT" ;
    pm:hasTotalSpaces 362 ;
    pm:locatedInDistrict dis:1 .

par:1419 a pm:RotationalParkingFacility ;
    pm:hasParCode 1419 ;
    pm:hasParkingName "ENCUENTRO" ;
    pm:hasParkingType "ROT" ;
    pm:hasTotalSpaces 90 ;
    pm:locatedInDistrict dis:14 .

# Examples from the supplied inventory data. 
# Empty source cells are omitted rather than converted to zero.
# Note that there are some mismatch in the entities of Parking Lot,
# so the distinguishing is just for comparison and demostration. 
# It doesn't necessarily means the final resolution.

par:912 a pm:ResidentParkingFacility ;
    pm:hasParCode 912 ;
    pm:hasParkingName "AGUILAR DE CAMPOO" ;
    pm:hasParkingType "RESIDENCIAL" ;
    pm:hasResidentSpaces 304 ;
    pm:hasTotalSpaces 304 ;
    pm:hasNumberOfFloors 3 ;
    pm:hasOperationalStatus "ABIERTO" ;
    pm:isPrivate false ;
    pm:isDisuasory false ;
    pm:hasServiceCode "0" ;
    geo:lat "40.4647124801429"^^xsd:decimal ;
    geo:long "-3.71937440247255"^^xsd:decimal ;
    pm:hasCadastralReference "9198744VK3799G0001XY" ;
    pm:hasOfficialURL <http://www.madrid.es/sites/v/index.jsp?vgnextchannel=bfa48ab43d6bb410VgnVCM100000171f5a0aRCRD&vgnextoid=d60868540e41c010VgnVCM2000000c205a0aRCRD> ;
    pm:hasPKCode "67711" ;
    pm:hasStreetAddress "CALLE DE ANTONIO MACHADO NUM 10, 28035 MADRID" ;
    pm:locatedInDistrict dis:9 ;
    pm:locatedInNeighbourhood bar:9-4 .

par:204 a pm:ResidentParkingFacility ;
