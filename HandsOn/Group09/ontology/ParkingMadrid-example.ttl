@prefix dis: <https://parking-madrid.example.org/resource/district/> .
@prefix occ: <https://parking-madrid.example.org/resource/occupancy/> .
@prefix par: <https://parking-madrid.example.org/resource/parking/> .
@prefix pm: <https://parking-madrid.example.org/ontology#> .

# -------------------------------------------------------- Districts

dis:7 a pm:District ;
    pm:hasDistrictCode 7 ;
    pm:hasDistrictName "CHAMBERI" .

dis:1 a pm:District ;
    pm:hasDistrictCode 1 ;
    pm:hasDistrictName "CENTRO" .

dis:14 a pm:District ;
    pm:hasDistrictCode 14 ;
    pm:hasDistrictName "MORATALAZ" .

# -------------------------------------------------------- Car parks

par:5000 a pm:RotationalParkingFacility ;
    pm:hasParCode 5000 ;
    pm:hasParkingName "ALMAGRO" ;
    pm:hasTotalSpaces 453 ;
    pm:locatedInDistrict dis:7 .

par:5012 a pm:RotationalParkingFacility ;
    pm:hasParCode 5012 ;
    pm:hasParkingName "OLAVIDE" ;
    pm:hasTotalSpaces 383 ;
    pm:locatedInDistrict dis:7 .

