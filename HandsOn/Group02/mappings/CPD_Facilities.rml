@prefix rr: <http://www.w3.org/ns/r2rml#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#>.
@prefix fno: <https://w3id.org/function/ontology#>.
@prefix d2rq: <http://www.wiwiss.fu-berlin.de/suhl/bizer/D2RQ/0.1#>.
@prefix void: <http://rdfs.org/ns/void#>.
@prefix dc: <http://purl.org/dc/terms/>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix rml: <http://semweb.mmlab.be/ns/rml#>.
@prefix ql: <http://semweb.mmlab.be/ns/ql#>.
@prefix : <http://mapping.example.com/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix pe: <http://smartcity.chicago.es/ontology/ParkExplorer#>.

:rules_000 a void:Dataset;
    void:exampleResource :map_facility_000.
:map_facility_000 rml:logicalSource :source_000.
:source_000 a rml:LogicalSource;
    rml:source "csv/CPD_Facilities_20261001-updated.csv";
    rml:referenceFormulation ql:CSV.
:map_facility_000 a rr:TriplesMap;
    rdfs:label "facility".
:s_000 a rr:SubjectMap.
:map_facility_000 rr:subjectMap :s_000.
:s_000 rr:template "http://smartcity.chicago.es/resource/Facility/{FACILITY_ID}".
:pom_000 a rr:PredicateObjectMap.
:map_facility_000 rr:predicateObjectMap :pom_000.
:pm_000 a rr:PredicateMap.
:pom_000 rr:predicateMap :pm_000.
:pm_000 rr:constant rdf:type.
:pom_000 rr:objectMap :om_000.
:om_000 a rr:ObjectMap;
    rr:constant pe:Facility;
    rr:termType rr:IRI.
:pom_001 a rr:PredicateObjectMap.
:map_facility_000 rr:predicateObjectMap :pom_001.
:pm_001 a rr:PredicateMap.
:pom_001 rr:predicateMap :pm_001.
:pm_001 rr:constant rdfs:label.
:pom_001 rr:objectMap :om_001.
:om_001 a rr:ObjectMap;
    rml:reference "FACILITY_NAME";
    rr:termType rr:Literal;
    rr:datatype xsd:string.
:pom_002 a rr:PredicateObjectMap.
:map_facility_000 rr:predicateObjectMap :pom_002.
:pm_002 a rr:PredicateMap.
:pom_002 rr:predicateMap :pm_002.
:pm_002 rr:constant pe:facilityName.
:pom_002 rr:objectMap :om_002.
:om_002 a rr:ObjectMap;
    rml:reference "FACILITY_NAME";
    rr:termType rr:Literal;
    rr:datatype xsd:string.
:pom_003 a rr:PredicateObjectMap.
:map_facility_000 rr:predicateObjectMap :pom_003.
:pm_003 a rr:PredicateMap.
:pom_003 rr:predicateMap :pm_003.
:pm_003 rr:constant pe:facilityType.
:pom_003 rr:objectMap :om_003.
:om_003 a rr:ObjectMap;
    rml:reference "FACILITY_TYPE";
    rr:termType rr:Literal;
    rr:datatype xsd:string.
:pom_004 a rr:PredicateObjectMap.
:map_facility_000 rr:predicateObjectMap :pom_004.
:pm_004 a rr:PredicateMap.
:pom_004 rr:predicateMap :pm_004.
:pm_004 rr:constant pe:facilityGisObjectId.
:pom_004 rr:objectMap :om_004.
:om_004 a rr:ObjectMap;
    rml:reference "GIS_OBJECT_ID";
    rr:termType rr:Literal;
    rr:datatype xsd:integer.
:pom_005 a rr:PredicateObjectMap.
:map_facility_000 rr:predicateObjectMap :pom_005.
:pm_005 a rr:PredicateMap.
:pom_005 rr:predicateMap :pm_005.
:pm_005 rr:constant schema:geo.
:pom_005 rr:objectMap :om_005.
:om_005 a rr:ObjectMap;
    rr:template "http://smartcity.chicago.es/resource/GeoCoordinates/Facility_{FACILITY_ID}";
    rr:termType rr:IRI.
:rules_000 void:exampleResource :map_facilityGeo_000.
:map_facilityGeo_000 rml:logicalSource :source_001.
:source_001 a rml:LogicalSource;
    rml:source "csv/CPD_Facilities_20261001-updated.csv";
    rml:referenceFormulation ql:CSV.
:map_facilityGeo_000 a rr:TriplesMap;
    rdfs:label "facilityGeo".
:s_001 a rr:SubjectMap.
:map_facilityGeo_000 rr:subjectMap :s_001.
:s_001 rr:template "http://smartcity.chicago.es/resource/GeoCoordinates/Facility_{FACILITY_ID}".
:pom_006 a rr:PredicateObjectMap.
:map_facilityGeo_000 rr:predicateObjectMap :pom_006.
:pm_006 a rr:PredicateMap.
:pom_006 rr:predicateMap :pm_006.
:pm_006 rr:constant rdf:type.
:pom_006 rr:objectMap :om_006.
:om_006 a rr:ObjectMap;
    rr:constant schema:GeoCoordinates;
    rr:termType rr:IRI.
:pom_007 a rr:PredicateObjectMap.
:map_facilityGeo_000 rr:predicateObjectMap :pom_007.
:pm_007 a rr:PredicateMap.
:pom_007 rr:predicateMap :pm_007.
:pm_007 rr:constant rdfs:label.
:pom_007 rr:objectMap :om_007.
:om_007 a rr:ObjectMap;
    rr:template "Coordinates of facility {FACILITY_ID}";
    rr:termType rr:Literal;
    rr:datatype xsd:string.
:pom_008 a rr:PredicateObjectMap.
:map_facilityGeo_000 rr:predicateObjectMap :pom_008.
:pm_008 a rr:PredicateMap.
:pom_008 rr:predicateMap :pm_008.
:pm_008 rr:constant schema:latitude.
:pom_008 rr:objectMap :om_008.
:om_008 a rr:ObjectMap;
    rml:reference "LATITUDE";
    rr:termType rr:Literal;
    rr:datatype xsd:double.
:pom_009 a rr:PredicateObjectMap.
:map_facilityGeo_000 rr:predicateObjectMap :pom_009.
:pm_009 a rr:PredicateMap.
:pom_009 rr:predicateMap :pm_009.
:pm_009 rr:constant schema:longitude.
:pom_009 rr:objectMap :om_009.
:om_009 a rr:ObjectMap;
    rml:reference "LONGITUDE";
    rr:termType rr:Literal;
    rr:datatype xsd:double.
:rules_000 void:exampleResource :map_parkFromFacilities_000.
:map_parkFromFacilities_000 rml:logicalSource :source_002.
:source_002 a rml:LogicalSource;
    rml:source "csv/CPD_Facilities_20261001-updated.csv";
    rml:referenceFormulation ql:CSV.
:map_parkFromFacilities_000 a rr:TriplesMap;
    rdfs:label "parkFromFacilities".
:s_002 a rr:SubjectMap.
:map_parkFromFacilities_000 rr:subjectMap :s_002.
:s_002 rr:template "http://smartcity.chicago.es/resource/ChicagoPark/{PARK_NO}".
:pom_010 a rr:PredicateObjectMap.
:map_parkFromFacilities_000 rr:predicateObjectMap :pom_010.
:pm_010 a rr:PredicateMap.
:pom_010 rr:predicateMap :pm_010.
:pm_010 rr:constant rdf:type.
:pom_010 rr:objectMap :om_010.
:om_010 a rr:ObjectMap;
    rr:constant pe:ChicagoPark;
    rr:termType rr:IRI.
:pom_011 a rr:PredicateObjectMap.
:map_parkFromFacilities_000 rr:predicateObjectMap :pom_011.
:pm_011 a rr:PredicateMap.
:pom_011 rr:predicateMap :pm_011.
:pm_011 rr:constant rdfs:label.
:pom_011 rr:objectMap :om_011.
:om_011 a rr:ObjectMap;
    rml:reference "PARK_NAME";
    rr:termType rr:Literal;
    rr:datatype xsd:string.
:pom_012 a rr:PredicateObjectMap.
:map_parkFromFacilities_000 rr:predicateObjectMap :pom_012.
:pm_012 a rr:PredicateMap.
:pom_012 rr:predicateMap :pm_012.
:pm_012 rr:constant pe:parkName.
:pom_012 rr:objectMap :om_012.
:om_012 a rr:ObjectMap;
    rml:reference "PARK_NAME";
    rr:termType rr:Literal;
    rr:datatype xsd:string.
:pom_013 a rr:PredicateObjectMap.
:map_parkFromFacilities_000 rr:predicateObjectMap :pom_013.
:pm_013 a rr:PredicateMap.
:pom_013 rr:predicateMap :pm_013.
:pm_013 rr:constant pe:parkNumber.
:pom_013 rr:objectMap :om_013.
:om_013 a rr:ObjectMap;
    rml:reference "PARK_NO";
    rr:termType rr:Literal;
    rr:datatype xsd:integer.
:pom_014 a rr:PredicateObjectMap.
:map_parkFromFacilities_000 rr:predicateObjectMap :pom_014.
:pm_014 a rr:PredicateMap.
:pom_014 rr:predicateMap :pm_014.
:pm_014 rr:constant pe:hasFacility.
:pom_014 rr:objectMap :om_014.
:om_014 a rr:ObjectMap;
    rr:template "http://smartcity.chicago.es/resource/Facility/{FACILITY_ID}";
    rr:termType rr:IRI.
