# ==========================================
# SAFEROUTEMADRID - RDF DATA VALIDATION QUERIES
# ==========================================

# ------------------------------------------
# BLOQUE 1: ESTADÍSTICAS GENERALES Y CONTEO
# ------------------------------------------

# 1. Conteo por Clases (Estadísticas generales de entidades y conceptos)
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT ?rdfClass (COUNT(?s) AS ?total)
WHERE {
  ?s rdf:type ?rdfClass.
}
GROUP BY ?rdfClass
ORDER BY DESC(?total);


# ------------------------------------------
# BLOQUE 2: AUDITORÍA DE ORFANDAD E INTEGRIDAD REFERENCIAL
# ------------------------------------------

# 2. Accidentes sin fecha registrada
PREFIX ns: <https://w3id.org/saferoutemadrid/ontology#>
SELECT ?accident
WHERE {
  ?accident a ns:TrafficAccident .
  FILTER NOT EXISTS { ?accident ns:accidentDate ?date . }
}
LIMIT 5;

# 3. Vehículos huérfanos (sin accidente asociado)
PREFIX ns: <https://w3id.org/saferoutemadrid/ontology#>
SELECT ?vehicle
WHERE {
  ?vehicle a ns:Vehicle .
  FILTER NOT EXISTS {
    ?accident ns:involvesVehicle ?vehicle .
  }
}
LIMIT 10;

# 4. Personas huérfanas (sin vehículo/accidente asociado)
PREFIX ns: <https://w3id.org/saferoutemadrid/ontology#>
SELECT ?person
WHERE {
  ?person a ns:Person .
  FILTER NOT EXISTS {
    ?vehicle ns:involvesPerson ?person .
  }
}
LIMIT 10;

# 5. Ubicaciones sin accidente asociado
PREFIX ns: <https://w3id.org/saferoutemadrid/ontology#>
SELECT ?location
WHERE {
  ?location a ns:Location .
  FILTER NOT EXISTS {
    ?accident ns:occursAt ?location .
  }
};

# 6. Ubicaciones con distritos mal enlazados o inexistentes
PREFIX ns: <https://w3id.org/saferoutemadrid/ontology#>
SELECT ?location ?district
WHERE {
  ?location a ns:Location ;
            ns:locatedIn ?district .
  FILTER NOT EXISTS {
    ?district a ns:District .
  }
};


# ------------------------------------------
# BLOQUE 3: CONTROL DE CALIDAD DE DATOS Y VALIDACIÓN DE DATATYPES
# ------------------------------------------

# 7. Entidades principales sin etiqueta descriptiva (rdfs:label)
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ns: <https://w3id.org/saferoutemadrid/ontology#>
SELECT ?individual ?clase
WHERE {
  ?individual rdf:type ?clase .
  FILTER(?clase IN (ns:TrafficAccident, ns:Vehicle, ns:Person, ns:Location, ns:District))
  FILTER NOT EXISTS { ?individual rdfs:label ?label . }
};

# 8. Comprobación de Datatypes correctos en booleanos (ej. positiveAlcohol)
PREFIX ns: <https://w3id.org/saferoutemadrid/ontology#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?person ?alcoholValue
WHERE {
  ?person ns:positiveAlcohol ?alcoholValue .
  FILTER(datatype(?alcoholValue) != xsd:boolean)
};

# 9. Detección de URIs mal formadas con dobles barras ("//")
SELECT DISTINCT ?s
WHERE {
  ?s ?p ?o .
  FILTER(isURI(?s))
  FILTER(CONTAINS(SUBSTR(STR(?s), 9), "//"))
};


# ------------------------------------------
# BLOQUE 4: MUESTRAS Y EXPLOTACIÓN DE DATOS
# ------------------------------------------

# 10. Muestra de relaciones encadenadas (Accidente -> Vehículo -> Persona -> Lesividad)
PREFIX ns: <https://w3id.org/saferoutemadrid/ontology#>
SELECT ?accident ?vehicle ?person ?severity
WHERE {
  ?accident ns:involvesVehicle ?vehicle .
  ?vehicle ns:involvesPerson ?person .
  ?person ns:hasInjurySeverity ?severity .
}
LIMIT 10;

# 11. Muestra de Accidentes, Fechas y Calles
PREFIX ns: <https://w3id.org/saferoutemadrid/ontology#>
SELECT ?accident ?date ?time ?street
WHERE {
  ?accident a ns:TrafficAccident ;
            ns:accidentDate ?date ;
            ns:accidentTime ?time ;
            ns:occursAt ?loc .
  OPTIONAL { ?loc ns:streetName ?street . }
}
LIMIT 5;

# 12. Personas con positivo en alcohol o drogas
PREFIX ns: <https://w3id.org/saferoutemadrid/ontology#>
SELECT ?person ?alcohol ?drug
WHERE {
  ?person a ns:Person ;
          ns:positiveAlcohol ?alcohol ;
          ns:positiveDrug ?drug .
  FILTER(?alcohol = true || ?drug = true)
}
LIMIT 10;
