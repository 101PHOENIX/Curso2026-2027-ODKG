@prefix ns: <https://w3id.org/saferoutemadrid/ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .

#################################################################
# EXAMPLE 1: Accident involving 3 people and 3 vehicles (Lateral collision)
# Description: Lateral collision between passenger cars on Goya Street (District 4).
#################################################################

ns:TrafficAccident/2026S000001
    a ns:TrafficAccident ;
    ns:accidentID "2026S000001"^^xsd:string ;
    ns:accidentDate "2026-01-01"^^xsd:date ;
    ns:accidentTime "03:00:00"^^xsd:time ;
    ns:occursAt ns:Location/2026S000001 ;
    ns:locatedIn ns:District/4 ;
    ns:hasAccidentType ns:AccidentType/ColisionLateral ;
    ns:hasWeatherCondition ns:WeatherCondition/Despejado ;
    ns:involvesVehicle ns:Vehicle/2026S000001-1 ;
    ns:involvesVehicle ns:Vehicle/2026S000001-2 .

ns:Location/2026S000001
    a ns:Location ;
    ns:streetName "CALL. GOYA"^^xsd:string ;
    ns:streetNumber "46"^^xsd:string ;
    ns:xCoordinate "442386.41"^^xsd:double ; 
    ns:yCoordinate "4475140.23"^^xsd:double .


ns:District/4
    a ns:District ;
    ns:districtCode 4 ;
    ns:districtName "Salamanca"^^xsd:string .

ns:Vehicle/2026S000001-1
    a ns:Vehicle ;
    ns:hasVehicleType ns:VehicleType/Turismo ;
    ns:involvesPerson ns:Person/2026S000001-1 .

ns:Vehicle/2026S000001-2
    a ns:Vehicle ;
    ns:hasVehicleType ns:VehicleType/Turismo ;
    ns:involvesPerson ns:Person/2026S000001-2 ;
    ns:involvesPerson ns:Person/2026S000001-3 .

ns:Person/2026S000001-1
    a ns:Person ;
    ns:hasPersonType ns:PersonType/Conductor ;
    ns:hasAgeRange ns:AgeRange/21-24 ;
    ns:hasSex ns:Sex/Mujer ;
    ns:hasInjurySeverity ns:InjurySeverity/14 ;
    ns:positiveAlcohol false ;
    ns:positiveDrug false .

ns:Person/2026S000001-2
    a ns:Person ;
    ns:hasPersonType ns:PersonType/Conductor ;
    ns:hasAgeRange ns:AgeRange/30-34 ;
    ns:hasSex ns:Sex/Hombre ;
    ns:hasInjurySeverity ns:InjurySeverity/14 ;
    ns:positiveAlcohol false ;
    ns:positiveDrug false .

ns:Person/2026S000001-3
    a ns:Person ;
    ns:hasPersonType ns:PersonType/Pasajero ;
    ns:hasAgeRange ns:AgeRange/21-24 ;
    ns:hasSex ns:Sex/Mujer ;
    ns:positiveAlcohol false ;
    ns:positiveDrug false .


#################################################################
# EXAMPLE 2: Accident involving 2 people and 2 vehicles (Front-lateral collision)
# Description: Front-lateral collision between vehicles at the confluence 
# of Alar del Rey street and Zurrón promenade (District 21 - Villaverde).
#################################################################

ns:TrafficAccident/2026S000002
    a ns:TrafficAccident ;
    ns:accidentID "2026S000002"^^xsd:string ;
    ns:accidentDate "2026-01-01"^^xsd:date ;
    ns:accidentTime "03:00:00"^^xsd:time ;
    ns:occursAt ns:Location/2026S000002 ;
    ns:locatedIn ns:District/21 ;
    ns:hasAccidentType ns:AccidentType/ColisionFrontoLateral ;
    ns:hasWeatherCondition ns:WeatherCondition/Despejado ;
    ns:involvesVehicle ns:Vehicle/2026S000002-1 ;
    ns:involvesVehicle ns:Vehicle/2026S000002-2 .

ns:Location/2026S000002
    a ns:Location ;
    ns:streetName "CALL. ALAR DEL REY / PASEO. ZURRON"^^xsd:string ;
    ns:streetNumber "5"^^xsd:string ;
    ns:xCoordinate "450564.66"^^xsd:double ; 
    ns:yCoordinate "4480043.99"^^xsd:double .


ns:District/21
    a ns:District ;
    ns:districtCode 21 ;
    ns:districtName "Barajas"^^xsd:string .

ns:Vehicle/2026S000002-1
    a ns:Vehicle ;
    ns:involvesPerson ns:Person/2026S000002-1 .

ns:Vehicle/2026S000002-2
    a ns:Vehicle ;
    ns:hasVehicleType ns:VehicleType/Turismo ;
    ns:involvesPerson ns:Person/2026S000002-2 .

ns:Person/2026S000002-1
    a ns:Person ;
    ns:hasPersonType ns:PersonType/Conductor ;
    ns:hasAgeRange ns:AgeRange/Desconocido ;
    ns:hasSex ns:Sex/Desconocido ;
    ns:positiveAlcohol false ;
    ns:positiveDrug false .

ns:Person/2026S000002-2
    a ns:Person ;
    ns:hasPersonType ns:PersonType/Conductor ;
    ns:hasAgeRange ns:AgeRange/Desconocido ;
    ns:hasSex ns:Sex/Desconocido ;
    ns:positiveAlcohol false ;
    ns:positiveDrug false .


#################################################################
# EXAMPLE 3: Accident involving a pedestrian and a motorcycle (Pedestrian collision)
# Description: Pedestrian collision on Ascao Street / Gutiérrez de Cetina Street (District 15 - Ciudad Lineal) 
# under clear weather conditions. A motorcyclist (with positive alcohol test results) on a motorcycle (>125cc) 
# strikes a pedestrian over 74 years old who suffers severe injuries with hospitalization over 24 hours.
#################################################################

ns:TrafficAccident/2026S000353
    a ns:TrafficAccident ;
    ns:accidentID "2026S000353"^^xsd:string ;
    ns:accidentDate "2026-01-02"^^xsd:date ;
    ns:accidentTime "13:20:00"^^xsd:time ;
    ns:occursAt ns:Location/2026S000353 ;
    ns:locatedIn ns:District/15 ;
    ns:hasAccidentType ns:AccidentType/AtropelloAPersona ;
    ns:hasWeatherCondition ns:WeatherCondition/Despejado ;
    ns:involvesVehicle ns:Vehicle/2026S000353-1 .

ns:Location/2026S000353
    a ns:Location ;
    ns:streetName "CALL. ASCAO / CALL. GUTIERRE DE CETINA"^^xsd:string ;
    ns:streetNumber "30"^^xsd:string ;
    ns:xCoordinate "445622.60"^^xsd:double ; 
    ns:yCoordinate "4475676.36"^^xsd:double . 



ns:District/15
    a ns:District ;
    ns:districtCode 15 ;
    ns:districtName "Ciudad Lineal"^^xsd:string .

ns:Person/2026S000353-1
    a ns:Person ;
    ns:hasPersonType ns:PersonType/Conductor ;
    ns:hasAgeRange ns:AgeRange/21-24 ;
    ns:hasSex ns:Sex/Hombre ;
    ns:hasInjurySeverity ns:InjurySeverity/14 ;
    ns:positiveAlcohol true ;
    ns:positiveDrug false .

ns:Person/2026S000353-2
    a ns:Person ;
    ns:hasPersonType ns:PersonType/Peaton ;
    ns:hasAgeRange ns:AgeRange/MasDe74 ;
    ns:hasSex ns:Sex/Mujer ;
    ns:hasInjurySeverity ns:InjurySeverity/3 ;
    ns:positiveAlcohol false ;
    ns:positiveDrug false .

ns:Vehicle/2026S000353-1
    a ns:Vehicle ;
    ns:hasVehicleType ns:VehicleType/MotocicletaMayor125cc ;
    ns:involvesPerson ns:Person/2026S000353-1 ;
    ns:involvesPerson ns:Person/2026S000353-2 .




