      rr:language "es"
    ]
  ] .

<#PersonType> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "./data/traffic_accidents_updated.csv" ;
    rml:referenceFormulation ql:CSV
  ];
  rr:subjectMap [
    rr:template "https://w3id.org/saferoutemadrid/resource/PersonType/{tipo_persona}";
    rr:class ns:PersonType, skos:Concept
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label, skos:prefLabel;
    rr:objectMap [
      rml:reference "tipo_persona";
      rr:language "es"
    ]
  ] .

<#AgeRange> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "./data/traffic_accidents_updated.csv" ;
    rml:referenceFormulation ql:CSV
  ];
  rr:subjectMap [
    rr:template "https://w3id.org/saferoutemadrid/resource/AgeRange/{rango_edad}";
    rr:class ns:AgeRange, skos:Concept
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label, skos:prefLabel;
    rr:objectMap [
      rml:reference "rango_edad";
      rr:language "es"
    ]
  ] .

<#Sex> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "./data/traffic_accidents_updated.csv" ;
    rml:referenceFormulation ql:CSV
  ];
  rr:subjectMap [
    rr:template "https://w3id.org/saferoutemadrid/resource/Sex/{sexo}";
    rr:class ns:Sex, skos:Concept
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label, skos:prefLabel;
    rr:objectMap [
      rml:reference "sexo";
      rr:language "es"
    ]
  ] .

<#InjurySeverity> a rr:TriplesMap;
  rml:logicalSource [
    rml:source "./data/traffic_accidents_updated.csv" ;
    rml:referenceFormulation ql:CSV
  ];
  rr:subjectMap [
    rr:template "https://w3id.org/saferoutemadrid/resource/InjurySeverity/{lesividad}";
    rr:class ns:InjurySeverity, skos:Concept
  ];

  rr:predicateObjectMap [
    rr:predicate rdfs:label, skos:prefLabel;
    rr:objectMap [
      rml:reference "lesividad";
      rr:language "es"
    ]
  ];

  rr:predicateObjectMap [
    rr:predicate skos:notation;
    rr:objectMap [
      rml:reference "cod_lesividad";
      rr:datatype xsd:string
    ]
  ] .
